<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.jarvis.backtalk-watcher</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>-c</string>
		<string>/bin/bash &lt; /Users/yousif/Desktop/jarvis/backtalk/watch_claude.sh</string>
	</array>
	<key>StartInterval</key>
	<integer>10</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/Users/yousif/Library/Logs/jarvis/backtalk-watcher.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/yousif/Library/Logs/jarvis/backtalk-watcher.log</string>
</dict>
</plist>
